@page "/ingredients"
@rendermode InteractiveServer
@using BakeTrack.Models
@using BakeTrack.Services
@inject IngredientService IngredientService

<PageTitle>Ingredients | BakeTrack</PageTitle>

<div class="container-fluid px-0 pb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="mb-1">Ingredients</h1>
            <p class="text-muted mb-0">Add, edit, and monitor bakery ingredient inventory.</p>
        </div>
        @if (!showForm)
        {
            <button type="button" class="btn btn-primary" @onclick="StartAdd">
                <i class="bi bi-plus-lg me-1"></i> Add Ingredient
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(statusIsError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @statusMessage
            <button type="button" class="btn-close" aria-label="Close" @onclick="ClearStatus"></button>
        </div>
    }

    @if (showForm)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">@(isEditing ? "Edit Ingredient" : "Add New Ingredient")</h2>
                <button type="button" class="btn-close" aria-label="Close form" @onclick="CancelForm"></button>
            </div>
            <div class="card-body">
                <EditForm Model="formModel" OnValidSubmit="HandleValidSubmit" FormName="IngredientForm">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="alert alert-danger" role="alert">
                            @formError
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label for="ingredient-name" class="form-label">Name <span class="text-danger">*</span></label>
                            <InputText id="ingredient-name" class="form-control" @bind-Value="formModel.Name" placeholder="e.g., Bread Flour" />
                            <ValidationMessage For="() => formModel.Name" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="ingredient-unit" class="form-label">Unit <span class="text-danger">*</span></label>
                            <InputText id="ingredient-unit" class="form-control" list="unit-suggestions" @bind-Value="formModel.Unit" placeholder="e.g., kg, g, L, units" />
                            <datalist id="unit-suggestions">
                                <option value="kg" />
                                <option value="g" />
                                <option value="L" />
                                <option value="mL" />
                                <option value="units" />
                                <option value="lb" />
                                <option value="oz" />
                            </datalist>
                            <ValidationMessage For="() => formModel.Unit" />
                        </div>

                        <div class="col-12 col-sm-6 col-md-4">
                            <label for="ingredient-qty" class="form-label">Quantity in Stock <span class="text-danger">*</span></label>
                            <InputNumber id="ingredient-qty" class="form-control" step="any" @bind-Value="formModel.QuantityInStock" ParsingErrorMessage="Quantity must be a valid number." />
                            <ValidationMessage For="() => formModel.QuantityInStock" />
                        </div>

                        <div class="col-12 col-sm-6 col-md-4">
                            <label for="ingredient-threshold" class="form-label">Minimum Stock Level <span class="text-danger">*</span></label>
                            <InputNumber id="ingredient-threshold" class="form-control" step="any" @bind-Value="formModel.LowStockThreshold" ParsingErrorMessage="Minimum stock level must be a valid number." />
                            <ValidationMessage For="() => formModel.LowStockThreshold" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label for="ingredient-expiry" class="form-label">Expiry Date (Optional)</label>
                            <InputDate id="ingredient-expiry" class="form-control" @bind-Value="formModel.ExpiryDate" />
                            <ValidationMessage For="() => formModel.ExpiryDate" />
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @(isSaving ? "Saving..." : (isEditing ? "Save Changes" : "Save Ingredient"))
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelForm" disabled="@isSaving">
                            Cancel
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (pendingDelete is not null)
    {
        <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4" role="alert">
            <div>
                Are you sure you want to delete <strong>@pendingDelete.Name</strong>? This action cannot be undone.
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-danger btn-sm" @onclick="ConfirmDeleteAsync" disabled="@isSaving">
                    Confirm Delete
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelDelete" disabled="@isSaving">
                    Cancel
                </button>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-muted py-4">Loading ingredients...</div>
    }
    else if (ingredients.Count == 0)
    {
        <div class="card border-dashed text-center p-4">
            <div class="card-body">
                <i class="bi bi-box-seam fs-1 text-muted"></i>
                <h3 class="h5 mt-3">No ingredients found</h3>
                <p class="text-muted mb-3">Start tracking your bakery inventory by adding your first ingredient.</p>
                @if (!showForm)
                {
                    <button type="button" class="btn btn-primary" @onclick="StartAdd">
                        <i class="bi bi-plus-lg me-1"></i> Add Ingredient
                    </button>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Quantity</th>
                            <th>Min Stock</th>
                            <th>Expiry Date</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ingredients)
                        {
                            var isLowStock = item.QuantityInStock <= item.LowStockThreshold;
                            <tr>
                                <td class="fw-medium">@item.Name</td>
                                <td>@item.QuantityInStock.ToString("0.###") @item.Unit</td>
                                <td>@item.LowStockThreshold.ToString("0.###") @item.Unit</td>
                                <td>@(item.ExpiryDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td>
                                    @if (isLowStock)
                                    {
                                        <span class="badge bg-warning text-dark">Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">In Stock</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group" aria-label="Actions for @item.Name">
                                        <button type="button" class="btn btn-outline-primary" @onclick="() => StartEdit(item)">
                                            Edit
                                        </button>
                                        <button type="button" class="btn btn-outline-danger" @onclick="() => RequestDelete(item)">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<Ingredient> ingredients = new();
    private Ingredient formModel = new();
    private Ingredient? pendingDelete;
    private bool isLoading = true;
    private bool showForm;
    private bool isEditing;
    private bool isSaving;
    private string? formError;
    private string? statusMessage;
    private bool statusIsError;

    protected override async Task OnInitializedAsync()
    {
        await LoadIngredientsAsync();
    }

    private async Task LoadIngredientsAsync()
    {
        isLoading = true;
        try
        {
            ingredients = await IngredientService.GetAllAsync();
        }
        catch (Exception)
        {
            statusMessage = "Unable to load ingredients from the database.";
            statusIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartAdd()
    {
        formModel = new Ingredient();
        isEditing = false;
        showForm = true;
        formError = null;
        pendingDelete = null;
        ClearStatus();
    }

    private void StartEdit(Ingredient item)
    {
        formModel = new Ingredient
        {
            Id = item.Id,
            Name = item.Name,
            Unit = item.Unit,
            QuantityInStock = item.QuantityInStock,
            LowStockThreshold = item.LowStockThreshold,
            ExpiryDate = item.ExpiryDate
        };
        isEditing = true;
        showForm = true;
        formError = null;
        pendingDelete = null;
        ClearStatus();
    }

    private void CancelForm()
    {
        showForm = false;
        isEditing = false;
        formError = null;
        formModel = new Ingredient();
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        formError = null;
        ClearStatus();

        try
        {
            var result = isEditing
                ? await IngredientService.UpdateAsync(formModel)
                : await IngredientService.CreateAsync(formModel);

            if (!result.Success)
            {
                formError = result.ErrorMessage;
                return;
            }

            var savedName = formModel.Name.Trim();
            statusMessage = isEditing
                ? $"Updated '{savedName}'."
                : $"Added '{savedName}'.";
            statusIsError = false;

            CancelForm();
            await LoadIngredientsAsync();
        }
        finally
        {
            isSaving = false;
        }
    }

    private void RequestDelete(Ingredient item)
    {
        pendingDelete = item;
        ClearStatus();
    }

    private void CancelDelete()
    {
        pendingDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (pendingDelete is null)
        {
            return;
        }

        isSaving = true;
        ClearStatus();

        try
        {
            var targetName = pendingDelete.Name;
            var result = await IngredientService.DeleteAsync(pendingDelete.Id);
            pendingDelete = null;

            if (!result.Success)
            {
                statusMessage = result.ErrorMessage;
                statusIsError = true;
                return;
            }

            statusMessage = $"Deleted '{targetName}'.";
            statusIsError = false;
            await LoadIngredientsAsync();
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ClearStatus()
    {
        statusMessage = null;
        statusIsError = false;
    }
}
