@using System.Security.Claims
@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <div class="top-user-bar">
                        <div class="top-user-identity">
                            <i class="bi bi-person-circle"></i>
                            <span class="top-user-name">@GetDisplayName(context.User)</span>
                            @if (context.User.IsInRole(AppRoles.Admin))
                            {
                                <span class="badge role-badge role-badge-admin">Admin</span>
                            }
                            else
                            {
                                <span class="badge role-badge role-badge-staff">Staff</span>
                            }
                        </div>

                        <div class="top-user-actions">
                            <a href="/account" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-key me-1"></i>
                                <span>Account</span>
                            </a>

                            <form method="post" action="/account/logout" class="m-0">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-box-arrow-right me-1"></i>
                                    <span>Sign Out</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static string GetDisplayName(ClaimsPrincipal user)
        => user.FindFirst(ApplicationUserClaimsPrincipalFactory.FullNameClaimType)?.Value
           ?? user.Identity?.Name
           ?? "User";
}
